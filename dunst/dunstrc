[global]
    ### Display
    monitor = 0
    follow = mouse
    geometry = "300x5-30+20"
    indicate_hidden = yes
    shrink = no
    transparency = 10
    notification_height = 0
    separator_height = 2
    separator_color = auto
    sort = yes
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = yes
    hide_duplicate_count = no
    show_indicators = yes

    ### Font
    font = FiraCode Nerd Font 10

    ### Icons
    icon_position = left
    max_icon_size = 32
    ### Updated icon_path to point to new directory and Adwaita fallback
    icon_path = /home/$USER/.config/dunst/icons:/usr/share/icons/Adwaita/16x16/actions:/usr/share/icons/Adwaita/16x16/apps:/usr/share/icons/Adwaita/scalable/actions:/usr/share/icons/Adwaita/scalable/apps

    ### History
    sticky_history = yes
    history_length = 20

    ### Misc
    dmenu = /usr/bin/rofi -dmenu
    browser = /usr/bin/xdg-open
    always_run_script = yes
    title = Dunst
    class = Dunst
    corner_radius = 10
    ignore_dbusclose = no

[frame]
    width = 2
    color = "#8AB4F8"

[urgency_low]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    timeout = 5

[urgency_normal]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    timeout = 10

[urgency_critical]
    background = "#F38BA8"
    foreground = "#1E1E2E"
    frame_color = "#F38BA8"
    timeout = 0

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[experimental]
    per_monitor_dpi = no
